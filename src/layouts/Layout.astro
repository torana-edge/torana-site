---
import "../styles/global.css";
import { websiteId } from "../lib/analytics";
import { meta } from "../data/pages";
import { product, repositoryURL } from "../data/product";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: boolean;
  /** Set on responses that are not destinations, such as the 404 page. */
  noindex?: boolean;
}

// Defaults are the homepage's own entry, so there is no second copy of them.
const home = meta("/");
const {
  title = home.title,
  description = home.description,
  image = "/social/torana.png",
  imageAlt = "Torana — a programmable proxy for coding agents. Local-first. Open source.",
  article = false,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Machine-readable identity, built from the shared product facts so a
// correction lands here and in /llms.txt together.
//
// The proxy and its plugins are deliberately modelled as two things. Torana
// itself is a native Go program; WebAssembly is the runtime its plugins are
// compiled to, and Rust appears only as a plugin language. Collapsing those
// into one entity told a reader the proxy ran on WebAssembly, which is wrong.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://torana.sh/#website",
      url: product.url,
      name: product.name,
      description:
        "A local-first programmable reverse proxy for coding agents, with WebAssembly plugins and an auditable local control plane.",
      inLanguage: "en",
      // The site is *about* the project. It is not published by it: schema.org
      // expects an Organization or Person there, and inventing one would assert
      // a legal entity that does not exist.
      about: { "@id": "https://torana.sh/#project" },
    },
    {
      "@type": "SoftwareSourceCode",
      "@id": "https://torana.sh/#project",
      name: product.name,
      description: product.summary,
      url: product.url,
      codeRepository: product.repository,
      programmingLanguage: product.language,
      applicationCategory: "DeveloperApplication",
      operatingSystem: product.operatingSystems.join(", "),
      license: product.license,
      isAccessibleForFree: true,
      // Plugins are a distinct artefact with their own languages and runtime.
      hasPart: {
        "@type": "SoftwareSourceCode",
        "@id": "https://torana.sh/#plugins",
        name: `${product.name} plugins`,
        description:
          "Sandboxed plugins loaded by the proxy. Each declares its capabilities and must be explicitly approved before it runs.",
        codeRepository: repositoryURL("torana-plugins"),
        programmingLanguage: [...product.pluginLanguages],
        runtimePlatform: product.pluginRuntime,
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="oklch(13% 0.018 220)" />
    <script is:inline src="/theme.js"></script>
    {websiteId && !noindex && <script is:inline defer src="/analytics.js" data-website-id={websiteId} data-page={canonical.pathname}></script>}
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="frame nav-inner">
        <a class="brand" href="/" aria-label="Torana home">
          <img class="brand-mark" src="/torana-logo.svg" alt="" width="28" height="28" />
          Torana
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href="/how-it-works/">How it works</a>
          <a href="/quickstart/">Quickstart</a>
          <a href="/docs/">Docs</a>
          <a href="/plugins/">Plugins</a>
          <a href="/blog/">Blog</a>
        </nav>
        <div class="nav-tools">
          <a class="nav-action" href="https://github.com/torana-edge/torana-edge">GitHub ↗</a>
          <label class="theme-control" hidden><span class="sr-only">Theme</span>
            <select id="theme-choice" aria-label="Color theme">
              <option value="system">System</option>
              <option value="light">Light</option>
              <option value="dark">Dark</option>
            </select>
          </label>
          <details class="mobile-menu">
            <summary>Menu</summary>
            <nav aria-label="Mobile">
              <a href="/how-it-works/">How it works</a>
              <a href="/quickstart/">Quickstart</a>
              <a href="/docs/">Docs</a>
              <a href="/plugins/">Plugins</a>
              <a href="/blog/">Blog</a>
              <a href="https://github.com/torana-edge/torana-edge">GitHub ↗</a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="foot">
      <div class="frame">
        <p class="foot-line">Your agent traffic. <span>Your machine.</span> Your rules.</p>
        <div class="foot-meta">
          <span><a href="https://github.com/torana-edge/torana-edge/blob/main/CONTRIBUTING.md">Contributors welcome</a></span>
          <span><a href="/docs/">Docs</a> · <a href="/plugins/">Plugins</a> · <a href="/blog/">Blog</a> · <a href="https://github.com/torana-edge">GitHub</a></span>
          <span>Open source · 2026 · <a href="/privacy/">Privacy</a></span>
        </div>
      </div>
    </footer>
    <p class="sr-only" id="copy-status" aria-live="polite"></p>
    <script is:inline src="/copy.js"></script>
  </body>
</html>
