{
  "name": "torana-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check:security": "node scripts/check-security-headers.mjs",
    "build": "npm run check:security && ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "registry:sync": "node scripts/sync-registry.mjs",
    "registry:check": "node scripts/sync-registry.mjs --check",
    "owned-content:check": "node scripts/check-owned-content.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^7.2.2",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "wrangler": "^4.123.0"
  },
  "overrides": {
    "astro": {
      "sharp": "^0.35.3"
    }
  }
}
